                <div style={{ fontSize:56, marginBottom:12 }}>🔍</div>
                <div style={{ fontWeight:600, fontSize:15, marginBottom:6 }}>Busca videos trending</div>
                <div style={{ fontSize:13, color:"#65676B" }}>Escribe un tema y presiona Buscar con IA</div>
              </div>
            )}
          </div>
        )}

        {/* ===== HASHTAGS ===== */}
        {tab === "hashtags" && (
          <div>
            <h2 style={{ color:"#1877F2", marginBottom:16 }}>✍️ Generador de Títulos & #Hashtags</h2>
            <div style={s({ marginBottom:16 })}>
              <div style={{ display:"flex", gap:10 }}>
                <input value={hTopic} onChange={e=>setHTopic(e.target.value)}
                  onKeyDown={e=>e.key==="Enter"&&generateHashtags()}
                  placeholder="Tema de tu video (ej: recetas mexicanas, gaming, fitness)..."
                  style={{ flex:1, padding:"10px 14px", borderRadius:8, border:"1.5px solid #E4E6EA", fontSize:14 }} />
                {platBtn(hLoading?"⏳ Generando...":"⚡ Generar con IA", generateHashtags, "#1877F2", hLoading, { minWidth:140 })}
              </div>
            </div>

            {hLoading && (
              <div style={{ textAlign:"center", padding:50, color:"#65676B" }}>
                <div style={{ fontSize:44, marginBottom:10 }}>✨</div>
                <div style={{ fontWeight:600 }}>Generando títulos y hashtags virales...</div>
              </div>
            )}

            {hResults && (
              <div style={{ display:"grid", gridTemplateColumns:"repeat(3,1fr)", gap:14 }}>
                {Object.entries(hResults).map(([platform, data]) => (
                  <div key={platform} style={{ background:"white", borderRadius:12, padding:18, boxShadow:"0 2px 8px rgba(0,0,0,0.07)", borderTop:`4px solid ${PC[platform]}` }}>
                    <div style={{ fontWeight:800, color:PC[platform], marginBottom:10, textTransform:"uppercase", fontSize:13 }}>
                      {PI[platform]} {platform}
                    </div>
                    <div style={{ fontWeight:700, fontSize:13, marginBottom:10 }}>📌 {data.title}</div>
                    <div style={{ marginBottom:10 }}>
                      {data.hashtags?.map((h,i) => (
                        <span key={i} style={{ display:"inline-block", background:PC[platform]+"15", color:PC[platform], padding:"2px 8px", borderRadius:20, fontSize:11, margin:"2px", fontWeight:700 }}>{h}</span>
                      ))}
                    </div>
                    <div style={{ fontSize:12, color:"#65676B", fontStyle:"italic", marginBottom:12, lineHeight:1.5 }}>📝 {data.caption}</div>
                    <div style={{ display:"flex", gap:8 }}>
                      <button onClick={()=>copyText(`${data.title}\n\n${data.hashtags?.join(" ")}\n\n${data.caption}`)}
                        style={{ flex:1, padding:"8px", background:"#F0F2F5", color:"#1877F2", border:"none", borderRadius:8, cursor:"pointer", fontSize:12, fontWeight:700 }}>
                        📋 Copiar
                      </button>
                      <button onClick={()=>{ setSForm(f=>({...f, title:data.title, platform, hashtags:data.hashtags?.join(" "), desc:data.caption})); setTab("scheduler"); showToast("📅 Enviado al planificador"); }}
                        style={{ flex:1, padding:"8px", background:PC[platform], color:"white", border:"none", borderRadius:8, cursor:"pointer", fontSize:12, fontWeight:700 }}>
                        📅 Programar
                      </button>
                    </div>
                  </div>
                ))}
              </div>
            )}

            {!hLoading && !hResults && (
              <div style={s({ textAlign:"center", padding:50 })}>
                <div style={{ fontSize:56, marginBottom:12 }}>✍️</div>
                <div style={{ fontWeight:600, fontSize:15, marginBottom:6 }}>Genera títulos y hashtags virales</div>
                <div style={{ fontSize:13, color:"#65676B" }}>Escribe el tema y presiona Generar con IA</div>
              </div>
            )}
          </div>
        )}

        {/* ===== LIBRARY ===== */}
        {tab === "library" && (
          <div>
            <div style={{ display:"flex", alignItems:"center", justifyContent:"space-between", marginBottom:16, flexWrap:"wrap", gap:10 }}>
              <h2 style={{ color:"#1877F2" }}>🗄️ Almacén ({library.length})</h2>
              <div style={{ display:"flex", gap:8 }}>
                {["all","youtube","tiktok","facebook"].map(f => (
                  <button key={f} onClick={()=>setLibFilter(f)} style={{ padding:"6px 14px", borderRadius:20, border:"none", cursor:"pointer", fontSize:12, fontWeight:700, background:libFilter===f?"#1877F2":"#F0F2F5", color:libFilter===f?"white":"#65676B" }}>
                    {f==="all"?"🌐 Todos":PI[f]+" "+f.charAt(0).toUpperCase()+f.slice(1)}
                  </button>
                ))}
              </div>
            </div>

            {library.length === 0 ? (
              <div style={s({ textAlign:"center", padding:50 })}>
                <div style={{ fontSize:56, marginBottom:12 }}>📦</div>
                <div style={{ fontWeight:600, fontSize:15, marginBottom:6 }}>Tu almacén está vacío</div>
                <div style={{ fontSize:13, color:"#65676B", marginBottom:20 }}>Busca videos en Trending y guárdalos aquí.</div>
                <button onClick={()=>setTab("trending")} style={{ padding:"10px 24px", background:"#1877F2", color:"white", border:"none", borderRadius:8, cursor:"pointer", fontWeight:700 }}>
                  🔥 Ir a Trending →
                </button>
              </div>
            ) : libFiltered.length === 0 ? (
              <div style={s({ textAlign:"center", padding:40 })}>
                <div style={{ fontSize:13, color:"#65676B" }}>No hay videos de {libFilter} en el almacén.</div>
              </div>
            ) : (
              <div style={{ display:"grid", gridTemplateColumns:"repeat(2,1fr)", gap:14 }}>
                {libFiltered.map((v) => (
                  <div key={v.id} style={{ background:"white", borderRadius:12, padding:16, boxShadow:"0 2px 8px rgba(0,0,0,0.07)", borderLeft:`4px solid ${PC[v.platform]||"#1877F2"}` }}>
                    <div style={{ display:"flex", justifyContent:"space-between", marginBottom:8 }}>
                      <span style={{ background:PC[v.platform]||"#1877F2", color:"white", padding:"2px 10px", borderRadius:20, fontSize:11, fontWeight:700 }}>
                        {PI[v.platform]} {v.platform?.toUpperCase()}
                      </span>
                      <span style={{ fontSize:11, color:"#65676B" }}>💾 {v.savedAt}</span>
                    </div>
                    <div style={{ fontWeight:700, fontSize:14, marginBottom:4, lineHeight:1.4 }}>{v.title}</div>
                    <div style={{ fontSize:12, color:"#65676B", marginBottom:10 }}>👤 {v.creator} · 👁 {v.views}</div>
                    <div style={{ display:"flex", gap:8 }}>
                      <button onClick={()=>sendToScheduler(v)} style={{ flex:1, padding:"8px", background:"#1877F2", color:"white", border:"none", borderRadius:8, cursor:"pointer", fontSize:12, fontWeight:700 }}>
                        📅 Programar
                      </button>
                      <button onClick={()=>{ setHTopic(v.title); setTab("hashtags"); }} style={{ flex:1, padding:"8px", background:"#F0F2F5", color:"#1C1E21", border:"none", borderRadius:8, cursor:"pointer", fontSize:12, fontWeight:700 }}>
                        ✍️ Hashtags
                      </button>
                      <button onClick={()=>removeFromLibrary(v.id)} style={{ padding:"8px 12px", background:"#FFE8E8", color:"#FF0000", border:"none", borderRadius:8, cursor:"pointer", fontSize:14 }}>
                        🗑
                      </button>
                    </div>
                  </div>
                ))}
              </div>
            )}
          </div>
        )}

        {/* ===== SCHEDULER ===== */}
        {tab === "scheduler" && (
          <div>
            <h2 style={{ color:"#1877F2", marginBottom:16 }}>📅 Planificador de Publicaciones</h2>
            <div style={s({ marginBottom:16 })}>
              <div style={{ fontWeight:700, marginBottom:14, fontSize:15 }}>➕ Nueva Publicación</div>
              <div style={{ display:"grid", gridTemplateColumns:"1fr 1fr", gap:10 }}>
                <input value={sForm.title} onChange={e=>setSForm(p=>({...p,title:e.target.value}))}
                  placeholder="Título del video o post *"
                  style={{ gridColumn:"1/-1", padding:"10px 14px", borderRadius:8, border:"1.5px solid #E4E6EA", fontSize:14 }} />
                <textarea value={sForm.desc} onChange={e=>setSForm(p=>({...p,desc:e.target.value}))}
                  placeholder="Descripción (opcional)"
                  style={{ gridColumn:"1/-1", padding:"10px 14px", borderRadius:8, border:"1.5px solid #E4E6EA", fontSize:14, resize:"vertical", minHeight:70 }} />
                <select value={sForm.platform} onChange={e=>setSForm(p=>({...p,platform:e.target.value}))}
                  style={{ padding:"10px 14px", borderRadius:8, border:"1.5px solid #E4E6EA", fontSize:14 }}>
                  <option value="tiktok">♪ TikTok</option>
                  <option value="youtube">▶ YouTube</option>
                  <option value="facebook">f Facebook</option>
                  <option value="all">🌐 Todas las plataformas</option>
                </select>
                <input value={sForm.hashtags} onChange={e=>setSForm(p=>({...p,hashtags:e.target.value}))}
                  placeholder="#hashtags (opcional)"
                  style={{ padding:"10px 14px", borderRadius:8, border:"1.5px solid #E4E6EA", fontSize:14 }} />
                <input type="date" value={sForm.date} onChange={e=>setSForm(p=>({...p,date:e.target.value}))}
                  style={{ padding:"10px 14px", borderRadius:8, border:"1.5px solid #E4E6EA", fontSize:14 }} />
                <input type="time" value={sForm.time} onChange={e=>setSForm(p=>({...p,time:e.target.value}))}
                  style={{ padding:"10px 14px", borderRadius:8, border:"1.5px solid #E4E6EA", fontSize:14 }} />
                <button onClick={schedulePost} style={{ gridColumn:"1/-1", padding:"12px", background:"linear-gradient(135deg,#1877F2,#0052cc)", color:"white", border:"none", borderRadius:8, cursor:"pointer", fontWeight:800, fontSize:15 }}>
                  📅 Programar Publicación →
                </button>
              </div>
            </div>

            {scheduled.length > 0 && (
              <div>
                <div style={{ fontWeight:700, marginBottom:12, fontSize:15 }}>📋 Publicaciones programadas ({scheduled.length})</div>
                <div style={{ display:"flex", flexDirection:"column", gap:10 }}>
                  {scheduled.map(p => (
                    <div key={p.id} style={{ background:"white", borderRadius:10, padding:14, display:"flex", alignItems:"center", gap:12, boxShadow:"0 2px 6px rgba(0,0,0,0.06)" }}>
                      <div style={{ width:42, height:42, borderRadius:"50%", background:PC[p.platform]||"#6B46C1", display:"flex", alignItems:"center", justifyContent:"center", color:"white", fontWeight:800, fontSize:16, flexShrink:0 }}>
                        {PI[p.platform]}
                      </div>
                      <div style={{ flex:1, minWidth:0 }}>
                        <div style={{ fontWeight:700, fontSize:14, overflow:"hidden", textOverflow:"ellipsis", whiteSpace:"nowrap" }}>{p.title}</div>
                        <div style={{ fontSize:12, color:"#65676B" }}>📅 {p.date} ⏰ {p.time}</div>
                      </div>
                      <span style={{ padding:"4px 12px", borderRadius:20, fontSize:12, fontWeight:700, background:p.status==="publicado"?"#E6F4EA":"#FFF8E1", color:p.status==="publicado"?"#1E7E34":"#856404", whiteSpace:"nowrap" }}>
                        {p.status==="publicado"?"✅ Publicado":"⏳ Programado"}
                      </span>
                      <button onClick={()=>deleteScheduled(p.id)} style={{ padding:"6px 10px", background:"#FFE8E8", color:"#FF0000", border:"none", borderRadius:8, cursor:"pointer", fontSize:14 }}>
                        🗑
                      </button>
                    </div>
                  ))}
                </div>
                <button onClick={()=>setTab("publish")} style={{ marginTop:16, width:"100%", padding:"12px", background:"linear-gradient(135deg,#1877F2,#0052cc)", color:"white", border:"none", borderRadius:8, cursor:"pointer", fontWeight:800, fontSize:15 }}>
                  🚀 Ir a Publicar →
                </button>
              </div>
            )}
          </div>
        )}

        {/* ===== PUBLISH ===== */}
        {tab === "publish" && (
          <div>
            <h2 style={{ color:"#1877F2", marginBottom:16 }}>🚀 Publicación Automática</h2>

            <div style={{ display:"grid", gridTemplateColumns:"repeat(3,1fr)", gap:12, marginBottom:20 }}>
              {["youtube","tiktok","facebook"].map(p => (
                <div key={p} style={{ background:"white", borderRadius:12, padding:16, textAlign:"center", boxShadow:"0 2px 8px rgba(0,0,0,0.07)", borderTop:`4px solid ${PC[p]}` }}>
                  <div style={{ fontSize:36, marginBottom:6 }}>{p==="youtube"?"▶️":p==="tiktok"?"🎵":"📘"}</div>
                  <div style={{ fontWeight:800, fontSize:14, marginBottom:6, textTransform:"capitalize" }}>{p}</div>
                  <span style={{ background:"#E6F4EA", color:"#1E7E34", padding:"3px 12px", borderRadius:20, fontSize:11, fontWeight:700 }}>✅ API Lista</span>
                </div>
              ))}
            </div>

            {scheduled.length === 0 ? (
              <div style={s({ textAlign:"center", padding:50 })}>
                <div style={{ fontSize:56, marginBottom:12 }}>🚀</div>
                <div style={{ fontWeight:600, fontSize:15, marginBottom:6 }}>No hay publicaciones listas</div>
                <div style={{ fontSize:13, color:"#65676B", marginBottom:20 }}>Ve al Planificador para programar contenido.</div>
                <div style={{ display:"flex", gap:10, justifyContent:"center", flexWrap:"wrap" }}>
                  <button onClick={()=>setTab("trending")} style={{ padding:"10px 20px", background:"#FF0050", color:"white", border:"none", borderRadius:8, cursor:"pointer", fontWeight:700 }}>
                    🔥 Buscar Trending →
                  </button>
                  <button onClick={()=>setTab("scheduler")} style={{ padding:"10px 20px", background:"#1877F2", color:"white", border:"none", borderRadius:8, cursor:"pointer", fontWeight:700 }}>
                    📅 Ir al Planificador →
                  </button>
                </div>
              </div>
            ) : (
              <div>
                <div style={{ display:"flex", justifyContent:"space-between", alignItems:"center", marginBottom:12, flexWrap:"wrap", gap:10 }}>
                  <div style={{ fontWeight:700, fontSize:15 }}>📤 Publicaciones ({scheduled.length})</div>
                  <div style={{ display:"flex", gap:8 }}>
                    <span style={{ fontSize:12, color:"#65676B" }}>
                      ⏳ {scheduled.filter(x=>x.status==="programado").length} pendientes · ✅ {scheduled.filter(x=>x.status==="publicado").length} publicados
                    </span>
                  </div>
                </div>

                <div style={{ display:"flex", flexDirection:"column", gap:10 }}>
                  {scheduled.map(p => {
                    const platforms = p.platform === "all" ? ["youtube","tiktok","facebook"] : [p.platform];
                    const allPublished = platforms.every(pl => publishStatus[`${p.id}_${pl}`] === "publicado") || p.status === "publicado";
                    const anyPublishing = platforms.some(pl => publishStatus[`${p.id}_${pl}`] === "publicando");

                    return (
                      <div key={p.id} style={{ background:"white", borderRadius:12, padding:16, boxShadow:"0 2px 8px rgba(0,0,0,0.07)", border:`1px solid ${allPublished?"#34A853":anyPublishing?"#1877F2":"#E4E6EA"}` }}>
                        <div style={{ display:"flex", alignItems:"center", gap:12, marginBottom:p.platform==="all"?12:0, flexWrap:"wrap" }}>
                          <div style={{ width:42, height:42, borderRadius:"50%", background:PC[p.platform]||"#6B46C1", display:"flex", alignItems:"center", justifyContent:"center", color:"white", fontWeight:800, fontSize:18, flexShrink:0 }}>
                            {PI[p.platform]}
                          </div>
                          <div style={{ flex:1, minWidth:0 }}>
                            <div style={{ fontWeight:700, fontSize:14, overflow:"hidden", textOverflow:"ellipsis", whiteSpace:"nowrap" }}>{p.title}</div>
                            <div style={{ fontSize:12, color:"#65676B" }}>📅 {p.date} · ⏰ {p.time}</div>
                            {p.hashtags && <div style={{ fontSize:11, color:"#1877F2", marginTop:2, overflow:"hidden", textOverflow:"ellipsis", whiteSpace:"nowrap" }}>{p.hashtags}</div>}
                          </div>
                          <div style={{ display:"flex", gap:8, alignItems:"center" }}>
                            {!allPublished && !anyPublishing && (
                              <button onClick={()=>openPublishModal(p)}
                                style={{ padding:"9px 18px", background:"linear-gradient(135deg,#FF0050,#c0003c)", color:"white", border:"none", borderRadius:8, cursor:"pointer", fontWeight:700, fontSize:13, whiteSpace:"nowrap" }}>
                                🚀 Publicar
                              </button>
                            )}
                            {anyPublishing && (
                              <span style={{ padding:"9px 18px", background:"#E7F3FF", color:"#1877F2", borderRadius:8, fontWeight:700, fontSize:13, whiteSpace:"nowrap" }}>
                                ⏳ Publicando...
                              </span>
                            )}
                            {allPublished && (
                              <span style={{ padding:"9px 18px", background:"#E6F4EA", color:"#1E7E34", borderRadius:8, fontWeight:700, fontSize:13, whiteSpace:"nowrap" }}>
                                ✅ Publicado
                              </span>
                            )}
                            <button onClick={()=>deleteScheduled(p.id)} style={{ padding:"8px 12px", background:"#FFE8E8", color:"#FF0000", border:"none", borderRadius:8, cursor:"pointer", fontSize:14 }}>
                              🗑
                            </button>
                          </div>
                        </div>

                        {p.platform === "all" && (
                          <div style={{ display:"flex", gap:8, flexWrap:"wrap" }}>
                            {["youtube","tiktok","facebook"].map(pl => {
                              const status = publishStatus[`${p.id}_${pl}`];
                              return (
                                <div key={pl} style={{ flex:1, minWidth:80, padding:"8px", background:status==="publicado"?"#E6F4EA":status==="publicando"?"#E7F3FF":"#F0F2F5", borderRadius:8, textAlign:"center" }}>
                                  <div style={{ fontSize:16 }}>{pl==="youtube"?"▶️":pl==="tiktok"?"🎵":"📘"}</div>
                                  <div style={{ fontSize:11, fontWeight:700, color:status==="publicado"?"#1E7E34":status==="publicando"?"#1877F2":"#65676B", marginTop:2 }}>
                                    {status==="publicado"?"✅ Listo":status==="publicando"?"⏳...":"⏸ Espera"}
                                  </div>
                                </div>
                              );
                            })}
                          </div>
                        )}
                      </div>
                    );
                  })}
                </div>
              </div>
            )}
          </div>
        )}
      </div>

      {/* AI CHAT FLOTANTE */}
      <div style={{ position:"fixed", bottom:20, right:20, zIndex:1000 }}>
        {showChat && (
          <div style={{ width:330, background:"white", borderRadius:18, boxShadow:"0 12px 40px rgba(0,0,0,0.22)", marginBottom:12, overflow:"hidden" }}>
            <div style={{ background:"linear-gradient(135deg,#1877F2,#0052cc)", color:"white", padding:"13px 16px", display:"flex", justifyContent:"space-between", alignItems:"center" }}>
              <div>
                <div style={{ fontWeight:800, fontSize:14 }}>🤖 Asistente IA</div>
                <div style={{ fontSize:11, opacity:0.85 }}>Experto en redes sociales</div>
              </div>
              <button onClick={()=>setShowChat(false)} style={{ background:"none", border:"none", color:"white", cursor:"pointer", fontSize:22, lineHeight:1 }}>×</button>
            </div>
            <div style={{ height:280, overflowY:"auto", padding:12, display:"flex", flexDirection:"column", gap:8, background:"#F8F9FA" }}>
              {chat.length === 0 && (
                <div style={{ color:"#65676B", fontSize:13, textAlign:"center", marginTop:20, lineHeight:1.8 }}>
                  ¡Hola! 👋 Pregúntame sobre:<br/>• Ideas de contenido viral<br/>• Estrategias por plataforma<br/>• Cómo crecer en redes sociales<br/>• Mejores horarios para publicar
                </div>
              )}
              {chat.map((m,i) => (
                <div key={i} style={{ display:"flex", justifyContent:m.role==="user"?"flex-end":"flex-start" }}>
                  <div style={{ maxWidth:"82%", padding:"9px 13px", borderRadius:12, background:m.role==="user"?"#1877F2":"white", color:m.role==="user"?"white":"#1C1E21", fontSize:13, boxShadow:"0 1px 4px rgba(0,0,0,0.1)", lineHeight:1.5 }}>
                    {m.content}
                  </div>
                </div>
              ))}
              {chatLoading && (
                <div style={{ display:"flex", gap:4, padding:"8px 12px", background:"white", borderRadius:12, alignSelf:"flex-start", boxShadow:"0 1px 4px rgba(0,0,0,0.1)" }}>
                  {[0,1,2].map(i=><div key={i} style={{ width:7, height:7, borderRadius:"50%", background:"#1877F2", animation:`bounce 1s ${i*0.2}s infinite` }}/>)}
                </div>
              )}
            </div>
            <div style={{ padding:"10px 12px", borderTop:"1px solid #E4E6EA", display:"flex", gap:8, background:"white" }}>
              <input value={chatInput} onChange={e=>setChatInput(e.target.value)}
                onKeyDown={e=>e.key==="Enter"&&sendChat()}
                placeholder="Escribe tu pregunta..."
                style={{ flex:1, padding:"9px 13px", borderRadius:22, border:"1.5px solid #E4E6EA", fontSize:13, outline:"none" }} />
              <button onClick={sendChat} disabled={chatLoading} style={{ width:36, height:36, borderRadius:"50%", background:"#1877F2", color:"white", border:"none", cursor:"pointer", fontSize:16, display:"flex", alignItems:"center", justifyContent:"center", flexShrink:0 }}>
                →
              </button>
            </div>
          </div>
        )}
        <button onClick={()=>setShowChat(p=>!p)} style={{ width:56, height:56, borderRadius:"50%", background:"linear-gradient(135deg,#1877F2,#0052cc)", color:"white", border:"none", cursor:"pointer", fontSize:24, boxShadow:"0 6px 20px rgba(24,119,242,0.55)", display:"flex", alignItems:"center", justifyContent:"center" }}>
          {showChat?"×":"🤖"}
        </button>
      </div>

      <style>{`
        @keyframes bounce { 0%,100%{transform:translateY(0);opacity:0.4} 50%{transform:translateY(-5px);opacity:1} }
        *{box-sizing:border-box}
        ::-webkit-scrollbar{width:5px}
        ::-webkit-scrollbar-thumb{background:#ccc;border-radius:10px}
        input:focus,select:focus,textarea:focus{outline:none!important;border-color:#1877F2!important}
        button:hover{opacity:0.9}
      `}</style>
    </div>
  );
}
